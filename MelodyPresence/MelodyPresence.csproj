<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows10.0.17763.0</TargetFramework>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>MelodyPresence</RootNamespace>
    <AssemblyName>MelodyPresence</AssemblyName>
    <Company>LT Services</Company>
    <Product>LT Services PrÃ©sence</Product>
    <AssemblyTitle>LT Services PrÃ©sence</AssemblyTitle>
    <Description>Gestion de prÃ©sence â€” vous Ãªtes dans de bonnes mains</Description>
    <Version>1.0.0</Version>
    <ApplicationIcon>Assets\lt_services.ico</ApplicationIcon>
    <ApplicationManifest>app.manifest</ApplicationManifest>
  </PropertyGroup>

  <ItemGroup>
    <Resource Include="Assets\lt_services.ico" />
    <Resource Include="Assets\lt_services_logo.png" />
    <Resource Include="Assets\lt_services_icon.png" />
    <Resource Include="Assets\lt_services_app.png" />
    <Resource Include="Assets\lt_services_brand.jpg" />
  </ItemGroup>

  <!-- Toasts Windows : fichiers sur disque (hero + logo circulaire) -->
  <ItemGroup>
    <Content Include="Assets\toast_hero_*.png" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="Assets\toast_logo_circle.png" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <!-- Liste employés LT + fiche salaire : préchargés à la 1re installation -->
  <ItemGroup>
    <Content Include="Assets\Seed\lt_services_employes.csv" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="Assets\Seed\FICHER_DE_SALAIRE_LT.xlsx" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <!-- Ã‰vite les collisions WPF / WinForms (NotifyIcon seulement). -->
  <ItemGroup>
    <Using Remove="System.Windows.Forms" />
    <Using Remove="System.Drawing" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="ClosedXML" Version="0.102.2" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Sqlite" Version="8.0.10" />
    <PackageReference Include="Microsoft.Toolkit.Uwp.Notifications" Version="7.1.3" />
    <PackageReference Include="QuestPDF" Version="2024.3.0" />
  </ItemGroup>

  <ItemGroup>
    <Compile Remove="..\ZktecoPullWorker\**\*" />
    <None Include="..\ZktecoPullWorker\**\*" />
  </ItemGroup>

  <Target Name="BuildZktecoPullWorker" BeforeTargets="BeforeBuild" Condition="'$(DesignTimeBuild)' != 'true'">
    <MSBuild Projects="$(MSBuildProjectDirectory)\..\ZktecoPullWorker\ZktecoPullWorker.csproj" Targets="Restore;Build" Properties="Configuration=$(Configuration)" />
  </Target>

  <Target Name="CopyZktecoPullWorker" AfterTargets="CopyFilesToOutputDirectory">
    <PropertyGroup>
      <_ZkWorkerBin>$(MSBuildProjectDirectory)\..\ZktecoPullWorker\bin\$(Configuration)\net48\</_ZkWorkerBin>
      <_ZkWorkerDest>$(OutputPath)ZktecoPullWorker\</_ZkWorkerDest>
    </PropertyGroup>
    <MakeDir Directories="$(_ZkWorkerDest)" Condition="Exists('$(_ZkWorkerBin)ZktecoPullWorker.exe')" />
    <ItemGroup>
      <_ZkWorkerFiles Include="$(_ZkWorkerBin)*.*" />
    </ItemGroup>
    <Copy SourceFiles="@(_ZkWorkerFiles)" DestinationFolder="$(_ZkWorkerDest)" SkipUnchangedFiles="true" Condition="Exists('$(_ZkWorkerBin)ZktecoPullWorker.exe')" />
  </Target>

  <Target Name="PublishZktecoPullWorker" AfterTargets="Publish">
    <PropertyGroup>
      <_ZkWorkerBin>$(MSBuildProjectDirectory)\..\ZktecoPullWorker\bin\$(Configuration)\net48\</_ZkWorkerBin>
      <_ZkWorkerPublishDest>$(PublishDir)ZktecoPullWorker\</_ZkWorkerPublishDest>
    </PropertyGroup>
    <MakeDir Directories="$(_ZkWorkerPublishDest)" Condition="Exists('$(_ZkWorkerBin)ZktecoPullWorker.exe')" />
    <ItemGroup>
      <_ZkWorkerPublishFiles Include="$(_ZkWorkerBin)*.*" />
    </ItemGroup>
    <Copy SourceFiles="@(_ZkWorkerPublishFiles)" DestinationFolder="$(_ZkWorkerPublishDest)" SkipUnchangedFiles="true" Condition="Exists('$(_ZkWorkerBin)ZktecoPullWorker.exe')" />
  </Target>

</Project>

