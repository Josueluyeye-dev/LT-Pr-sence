<Window x:Class="MelodyPresence.MainWindow"

        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"

        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"

        xmlns:vm="clr-namespace:MelodyPresence.ViewModels"

        Title="LT Services — Présence"

        Icon="pack://application:,,,/Assets/lt_services.ico"

        Height="860" Width="1440"

        MinHeight="700" MinWidth="1200"

        WindowStartupLocation="CenterScreen"

        WindowStyle="SingleBorderWindow"

        ResizeMode="CanResize"

        Background="#FFB8BEC8"

        FontFamily="Segoe UI, Segoe UI Variable Display"

        Loaded="Window_Loaded">

    <Window.DataContext>

        <vm:MainViewModel/>

    </Window.DataContext>



    <Window.Resources>

        <Style x:Key="NavRow" TargetType="StackPanel">

            <Setter Property="Orientation" Value="Horizontal"/>

        </Style>

    </Window.Resources>



    <Grid Background="#FFB8BEC8">

        <Grid>

            <Grid.ColumnDefinitions>

                <ColumnDefinition Width="228"/>

                <ColumnDefinition Width="*"/>

            </Grid.ColumnDefinitions>



            <!-- Sidebar — fond blanc (comme avant) -->

            <Border Grid.Column="0"

                    Background="White"

                    BorderBrush="{StaticResource BrushStroke}"

                    BorderThickness="0,0,1,0"

                    Padding="16,20,16,14">

                <DockPanel>

                    <StackPanel DockPanel.Dock="Top">

                        <StackPanel Margin="2,0,0,22">

                            <Border Background="White" CornerRadius="12" Padding="10,10"

                                    BorderBrush="#33E30613" BorderThickness="1">

                                <StackPanel>

                                    <Image Source="pack://application:,,,/Assets/lt_services_brand.jpg"

                                           Height="48" Stretch="Uniform"

                                           RenderOptions.BitmapScalingMode="HighQuality"

                                           HorizontalAlignment="Center"/>

                                    <TextBlock Text="Présence" FontSize="12" FontWeight="Bold"

                                               Foreground="#FFE30613" Margin="0,8,0,0"

                                               HorizontalAlignment="Center"/>

                                    <TextBlock Text="vous êtes dans de bonnes mains"

                                               FontSize="9" FontStyle="Italic"

                                               Foreground="#FF111827" FontWeight="Bold" Margin="0,2,0,0"

                                               HorizontalAlignment="Center" TextWrapping="Wrap"

                                               TextAlignment="Center"/>

                                </StackPanel>

                            </Border>

                        </StackPanel>



                        <RadioButton Style="{StaticResource NavButton}" GroupName="Nav"

                                     IsChecked="{Binding EstAccueil, Mode=OneWay}"

                                     Command="{Binding NaviguerCommand}" CommandParameter="Accueil">

                            <StackPanel Style="{StaticResource NavRow}">

                                <TextBlock Style="{StaticResource IconGlyph}" Text="&#xE80F;" Margin="0,0,12,0"

                                           Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}"/>

                                <TextBlock Text="Accueil" VerticalAlignment="Center"/>

                            </StackPanel>

                        </RadioButton>

                        <RadioButton Style="{StaticResource NavButton}" GroupName="Nav"

                                     IsChecked="{Binding EstEmployes, Mode=OneWay}"

                                     Command="{Binding NaviguerCommand}" CommandParameter="Employés">

                            <StackPanel Style="{StaticResource NavRow}">

                                <TextBlock Style="{StaticResource IconGlyph}" Text="&#xE716;" Margin="0,0,12,0"

                                           Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}"/>

                                <TextBlock Text="Employés" VerticalAlignment="Center"/>

                            </StackPanel>

                        </RadioButton>

                        <RadioButton Style="{StaticResource NavButton}" GroupName="Nav"

                                     IsChecked="{Binding EstPresence, Mode=OneWay}"

                                     Command="{Binding NaviguerCommand}" CommandParameter="Présence">

                            <StackPanel Style="{StaticResource NavRow}">

                                <TextBlock Style="{StaticResource IconGlyph}" Text="&#xE8D7;" Margin="0,0,12,0"

                                           Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}"/>

                                <TextBlock Text="Présence" VerticalAlignment="Center"/>

                            </StackPanel>

                        </RadioButton>

                        <RadioButton Style="{StaticResource NavButton}" GroupName="Nav"

                                     IsChecked="{Binding EstRapports, Mode=OneWay}"

                                     Command="{Binding NaviguerCommand}" CommandParameter="Rapports">

                            <StackPanel Style="{StaticResource NavRow}">

                                <TextBlock Style="{StaticResource IconGlyph}" Text="&#xE9D9;" Margin="0,0,12,0"

                                           Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}"/>

                                <TextBlock Text="Rapports" VerticalAlignment="Center"/>

                            </StackPanel>

                        </RadioButton>

                        <RadioButton Style="{StaticResource NavButton}" GroupName="Nav"

                                     IsChecked="{Binding EstPaie, Mode=OneWay}"

                                     Command="{Binding NaviguerCommand}" CommandParameter="Paie">

                            <StackPanel Style="{StaticResource NavRow}">

                                <TextBlock Style="{StaticResource IconGlyph}" Text="&#xE8A1;" Margin="0,0,12,0"

                                           Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}"/>

                                <TextBlock Text="Paie" VerticalAlignment="Center"/>

                            </StackPanel>

                        </RadioButton>

                        <RadioButton Style="{StaticResource NavButton}" GroupName="Nav"

                                     IsChecked="{Binding EstParametres, Mode=OneWay}"

                                     Command="{Binding NaviguerCommand}" CommandParameter="Paramètres">

                            <StackPanel Style="{StaticResource NavRow}">

                                <TextBlock Style="{StaticResource IconGlyph}" Text="&#xE713;" Margin="0,0,12,0"

                                           Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}"/>

                                <TextBlock Text="Paramètres" VerticalAlignment="Center"/>

                            </StackPanel>

                        </RadioButton>

                    </StackPanel>



                    <StackPanel DockPanel.Dock="Bottom" VerticalAlignment="Bottom" Margin="2,0,2,0">

                        <Border Style="{StaticResource MessageBanner}" Margin="0,0,0,10" Cursor="Hand">

                            <Border.InputBindings>

                                <MouseBinding Gesture="LeftClick" Command="{Binding ConfigurerTerminalCommand}"/>

                            </Border.InputBindings>

                            <DockPanel>

                                <Border DockPanel.Dock="Left" Width="34" Height="34" CornerRadius="9"

                                        Background="#33FFFFFF" Margin="0,0,10,0">

                                    <Grid>

                                        <TextBlock Text="&#xE770;" FontFamily="Segoe MDL2 Assets" FontSize="15"

                                                   Foreground="White"

                                                   HorizontalAlignment="Center" VerticalAlignment="Center"/>

                                        <Ellipse Width="8" Height="8" Fill="{Binding TerminalCarteBrush}"

                                                 HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,2,2,0"/>

                                    </Grid>

                                </Border>

                                <StackPanel VerticalAlignment="Center">

                                    <TextBlock Text="{Binding TerminalCarteTitre}" FontSize="12" FontWeight="SemiBold"

                                               Foreground="White" TextWrapping="Wrap"/>

                                    <TextBlock Text="{Binding TerminalCarteDetail}" FontSize="11"

                                               Foreground="White" FontWeight="Bold" TextWrapping="Wrap" Margin="0,2,0,0"/>

                                </StackPanel>

                            </DockPanel>

                        </Border>

                        <StackPanel Margin="4,0,0,2">
                            <StackPanel Orientation="Horizontal">
                                <Border Width="36" Height="36" CornerRadius="18" Background="#22E30613" Margin="0,0,10,0">
                                    <TextBlock Text="{Binding InitialesUtilisateur}" FontSize="12" FontWeight="Bold"
                                               Foreground="{StaticResource BrushAccent}"
                                               HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock Text="{Binding NomUtilisateurAffiche}" FontSize="12" FontWeight="SemiBold"
                                               Foreground="{StaticResource BrushText}"/>
                                    <TextBlock Text="{Binding RoleUtilisateurAffiche}" FontSize="11"
                                               Foreground="{StaticResource BrushText}" FontWeight="Bold"/>
                                </StackPanel>
                            </StackPanel>
                            <Button Content="Se déconnecter" Style="{StaticResource GhostButton}"
                                    Command="{Binding DeconnecterCommand}"
                                    Margin="0,10,0,0" Padding="10,6" MinHeight="32"
                                    HorizontalAlignment="Stretch"/>
                        </StackPanel>

                    </StackPanel>

                </DockPanel>

            </Border>



            <!-- Content — fond gris franc -->

            <Border Grid.Column="1" Background="#FFB8BEC8" Margin="0">

            <Grid x:Name="ContentHost" Opacity="1" Margin="18,14,18,12" Background="#FFB8BEC8">

                <!-- Accueil / Dashboard mockup -->

                <Grid Visibility="{Binding EstAccueil, Converter={StaticResource BoolToVis}}" Margin="0">

                    <Grid.ColumnDefinitions>

                        <ColumnDefinition Width="*"/>

                        <ColumnDefinition Width="268"/>

                    </Grid.ColumnDefinitions>



                    <!-- Colonne principale -->

                    <Grid Grid.Column="0" Margin="0,0,14,0">

                        <Grid.RowDefinitions>

                            <RowDefinition Height="Auto"/>

                            <RowDefinition Height="Auto"/>

                            <RowDefinition Height="Auto"/>

                            <RowDefinition Height="*"/>

                            <RowDefinition Height="Auto"/>

                        </Grid.RowDefinitions>



                        <!-- Header -->

                        <Grid Grid.Row="0" Margin="0,0,0,14">

                            <Grid.ColumnDefinitions>

                                <ColumnDefinition Width="*"/>

                                <ColumnDefinition Width="Auto"/>

                                <ColumnDefinition Width="Auto"/>

                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0" VerticalAlignment="Center">

                                <TextBlock Text="Dashboard" FontSize="28" FontWeight="Bold" Foreground="{StaticResource BrushText}"/>

                                <TextBlock Text="Vue du jour — présence en un coup d’œil" FontSize="13" FontWeight="SemiBold"

                                           Foreground="{StaticResource BrushTextSecondary}" Margin="0,4,0,0"/>

                            </StackPanel>



                            <Border Grid.Column="1" Background="{StaticResource BrushBgStatCard}" CornerRadius="10" Padding="6,4" Margin="12,0"

                                    BorderBrush="{StaticResource BrushStrokeStrong}" BorderThickness="1" VerticalAlignment="Center">

                                <StackPanel Orientation="Horizontal">

                                    <Button Style="{StaticResource QuietButton}" Content="‹" FontSize="16" Padding="10,4" Margin="0"

                                            Foreground="{StaticResource BrushTextSecondary}"

                                            Command="{Binding JourPrecedentCommand}" ToolTip="Jour précédent"/>

                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="4,0">

                                        <TextBlock FontFamily="Segoe MDL2 Assets" Text="&#xE787;" Foreground="{StaticResource BrushAccent}"

                                                   FontSize="13" Margin="0,0,8,0" VerticalAlignment="Center"/>

                                        <TextBlock Text="{Binding DatePresenceHeader}" FontSize="13" FontWeight="SemiBold"

                                                   Foreground="{StaticResource BrushText}" VerticalAlignment="Center"/>

                                    </StackPanel>

                                    <Button Style="{StaticResource QuietButton}" Content="›" FontSize="16" Padding="10,4" Margin="0"

                                            Foreground="{StaticResource BrushTextSecondary}"

                                            Command="{Binding JourSuivantCommand}" ToolTip="Jour suivant"/>

                                </StackPanel>

                            </Border>



                            <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">

                                <Button Style="{StaticResource GhostButton}" Content="Exporter ?" Margin="0,0,8,0"

                                        Background="{StaticResource BrushBgStatCard}" BorderBrush="{StaticResource BrushStrokeStrong}"

                                        Click="ExporterPresence_Click"/>

                                <Button Command="{Binding SynchroniserZkCommand}" Margin="0" Padding="16,10">

                                    <StackPanel Orientation="Horizontal">

                                        <TextBlock FontFamily="Segoe MDL2 Assets" Text="&#xE895;" Margin="0,0,8,0" VerticalAlignment="Center"/>

                                        <TextBlock Text="Synchroniser"/>

                                    </StackPanel>

                                </Button>

                            </StackPanel>

                        </Grid>



                        <!-- KPI -->

                        <UniformGrid Grid.Row="1" Columns="4" Margin="0,0,0,12">

                            <Border Style="{StaticResource StatCard}" Margin="0,0,10,0" MinHeight="108" Padding="14">

                                <Grid>

                                    <Path Data="M8,48 L22,40 34,44 48,28 62,34 78,18" Stroke="#99E30613" StrokeThickness="2.5"

                                          Stretch="Fill" Height="28" VerticalAlignment="Bottom" Margin="0,0,0,2"/>

                                    <DockPanel>

                                        <Border DockPanel.Dock="Right" Width="36" Height="36" CornerRadius="10" Background="#44E30613">

                                            <TextBlock Text="&#xE716;" FontFamily="Segoe MDL2 Assets" Foreground="#FFFF4D57" FontSize="16"

                                                       HorizontalAlignment="Center" VerticalAlignment="Center"/>

                                        </Border>

                                        <StackPanel>

                                            <TextBlock Text="EFFECTIF" FontSize="11" FontWeight="Bold" Foreground="{StaticResource BrushTextSecondary}"/>

                                            <TextBlock Text="{Binding CompteurEmployesActifs}" FontSize="32" FontWeight="Bold"

                                                       Foreground="{StaticResource BrushText}" Margin="0,6,0,0"/>

                                            <TextBlock Text="{Binding CompteurEffectifContexte}" FontSize="12" FontWeight="SemiBold"

                                                       Foreground="{StaticResource BrushTextSecondary}"/>

                                        </StackPanel>

                                    </DockPanel>

                                </Grid>

                            </Border>

                            <Border Style="{StaticResource StatCard}" Margin="0,0,10,0" MinHeight="108" Padding="14" Cursor="Hand">

                                <Border.InputBindings>

                                    <MouseBinding Gesture="LeftClick" Command="{Binding OuvrirPresenceFiltreCommand}" CommandParameter="PrésentsAuto"/>

                                </Border.InputBindings>

                                <Grid>

                                    <Path Data="M8,42 L24,36 38,38 52,24 68,28 82,14" Stroke="#6635D39A" StrokeThickness="2.5"

                                          Stretch="Fill" Height="28" VerticalAlignment="Bottom" Margin="0,0,0,2"/>

                                    <DockPanel>

                                        <Border DockPanel.Dock="Right" Width="36" Height="36" CornerRadius="10" Background="#2235D39A">

                                            <TextBlock Text="&#xE73E;" FontFamily="Segoe MDL2 Assets" Foreground="{StaticResource BrushSuccess}" FontSize="16"

                                                       HorizontalAlignment="Center" VerticalAlignment="Center"/>

                                        </Border>

                                        <StackPanel>

                                            <TextBlock Text="PRÉSENTS" FontSize="11" FontWeight="Bold" Foreground="{StaticResource BrushTextSecondary}"/>

                                            <TextBlock Text="{Binding CompteurPresents}" FontSize="32" FontWeight="Bold"

                                                       Foreground="{StaticResource BrushText}" Margin="0,6,0,0"/>

                                            <TextBlock Text="{Binding CompteurPresentsContexte}" FontSize="12" FontWeight="SemiBold"

                                                       Foreground="{StaticResource BrushSuccess}"/>

                                        </StackPanel>

                                    </DockPanel>

                                </Grid>

                            </Border>

                            <Border Style="{StaticResource StatCard}" Margin="0,0,10,0" MinHeight="108" Padding="14" Cursor="Hand">

                                <Border.InputBindings>

                                    <MouseBinding Gesture="LeftClick" Command="{Binding OuvrirPresenceFiltreCommand}" CommandParameter="RetardsAuto"/>

                                </Border.InputBindings>

                                <Grid>

                                    <Path Data="M8,30 L26,34 40,22 56,36 70,28 84,40" Stroke="#66FFC233" StrokeThickness="2.5"

                                          Stretch="Fill" Height="28" VerticalAlignment="Bottom" Margin="0,0,0,2"/>

                                    <DockPanel>

                                        <Border DockPanel.Dock="Right" Width="36" Height="36" CornerRadius="10" Background="#22FFC233">

                                            <TextBlock Text="&#xE916;" FontFamily="Segoe MDL2 Assets" Foreground="{StaticResource BrushWarning}" FontSize="16"

                                                       HorizontalAlignment="Center" VerticalAlignment="Center"/>

                                        </Border>

                                        <StackPanel>

                                            <TextBlock Text="RETARDS" FontSize="11" FontWeight="Bold" Foreground="{StaticResource BrushTextSecondary}"/>

                                            <TextBlock Text="{Binding CompteurRetards}" FontSize="32" FontWeight="Bold"

                                                       Foreground="{StaticResource BrushText}" Margin="0,6,0,0"/>

                                            <TextBlock Text="{Binding CompteurRetardsContexte}" FontSize="12" FontWeight="SemiBold"

                                                       Foreground="{StaticResource BrushWarning}"/>

                                        </StackPanel>

                                    </DockPanel>

                                </Grid>

                            </Border>

                            <Border Style="{StaticResource StatCard}" Margin="0" MinHeight="108" Padding="14" Cursor="Hand">

                                <Border.InputBindings>

                                    <MouseBinding Gesture="LeftClick" Command="{Binding OuvrirPresenceFiltreCommand}" CommandParameter="AbsentsAuto"/>

                                </Border.InputBindings>

                                <Grid>

                                    <Path Data="M8,18 L24,28 40,22 56,40 72,34 86,48" Stroke="#66FF6B72" StrokeThickness="2.5"

                                          Stretch="Fill" Height="28" VerticalAlignment="Bottom" Margin="0,0,0,2"/>

                                    <DockPanel>

                                        <Border DockPanel.Dock="Right" Width="36" Height="36" CornerRadius="10" Background="#22FF6B72">

                                            <TextBlock Text="&#xE711;" FontFamily="Segoe MDL2 Assets" Foreground="{StaticResource BrushDanger}" FontSize="16"

                                                       HorizontalAlignment="Center" VerticalAlignment="Center"/>

                                        </Border>

                                        <StackPanel>

                                            <TextBlock Text="{Binding LabelAbsentsOuNonPointes}" FontSize="11" FontWeight="Bold"

                                                       Foreground="{StaticResource BrushTextSecondary}"/>

                                            <TextBlock Text="{Binding CompteurAbsentsOuNonPointes}" FontSize="32" FontWeight="Bold"

                                                       Foreground="{StaticResource BrushText}" Margin="0,6,0,0"/>

                                            <TextBlock Text="{Binding CompteurAbsentsContexte}" FontSize="12" FontWeight="SemiBold"

                                                       Foreground="{StaticResource BrushDanger}"/>

                                        </StackPanel>

                                    </DockPanel>

                                </Grid>

                            </Border>

                        </UniformGrid>



                        <!-- Présence aujourd'hui — dégradé rouge ? noir + progression réelle -->

                        <Border Grid.Row="2" Margin="0,0,0,12" Padding="18" CornerRadius="16"

                                BorderBrush="#66FFFFFF" BorderThickness="1">

                            <Border.Background>

                                <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">

                                    <GradientStop Color="#FFE30613" Offset="0"/>

                                    <GradientStop Color="#FF8B0000" Offset="0.45"/>

                                    <GradientStop Color="#FF0A0A0A" Offset="1"/>

                                </LinearGradientBrush>

                            </Border.Background>

                            <Grid>

                                <Grid.ColumnDefinitions>

                                    <ColumnDefinition Width="130"/>

                                    <ColumnDefinition Width="*"/>

                                </Grid.ColumnDefinitions>

                                <Grid.RowDefinitions>

                                    <RowDefinition Height="Auto"/>

                                    <RowDefinition Height="Auto"/>

                                    <RowDefinition Height="Auto"/>

                                </Grid.RowDefinitions>



                                <DockPanel Grid.Row="0" Grid.ColumnSpan="2" Margin="0,0,0,12">

                                    <Border DockPanel.Dock="Right" Background="#33FFFFFF" CornerRadius="8" Padding="10,6">

                                        <TextBlock Text="{Binding TimelineProgressLibelle}" FontSize="12" FontWeight="Bold"

                                                   Foreground="White"/>

                                    </Border>

                                    <TextBlock Text="Présence aujourd'hui" FontSize="15" FontWeight="SemiBold"

                                               Foreground="White" VerticalAlignment="Center"/>

                                </DockPanel>



                                <!-- Donut -->

                                <Grid Grid.Row="1" Grid.Column="0" Width="110" Height="110" Margin="0,0,12,8">

                                    <Ellipse Width="96" Height="96" Stroke="#40FFFFFF" StrokeThickness="9"/>

                                    <Ellipse Width="96" Height="96" Stroke="White" StrokeThickness="9"

                                             StrokeDashArray="{Binding PresenceDonutDash}" StrokeDashCap="Round"

                                             RenderTransformOrigin="0.5,0.5">

                                        <Ellipse.RenderTransform>

                                            <RotateTransform Angle="-90"/>

                                        </Ellipse.RenderTransform>

                                    </Ellipse>

                                    <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">

                                        <TextBlock Text="{Binding PresenceAujourdhuiPourcentTexte}" FontSize="20" FontWeight="Bold"

                                                   Foreground="White" HorizontalAlignment="Center"/>

                                        <TextBlock Text="{Binding PresenceAujourdhuiRatio}" FontSize="11"

                                                   Foreground="White" FontWeight="Bold" HorizontalAlignment="Center"/>

                                    </StackPanel>

                                </Grid>



                                <StackPanel Grid.Row="1" Grid.Column="1" VerticalAlignment="Center" Margin="0,0,0,8">

                                    <TextBlock Text="{Binding PresenceAujourdhuiLibelle}" FontSize="14" FontWeight="SemiBold"

                                               Foreground="White" TextWrapping="Wrap"/>

                                    <TextBlock Text="{Binding TimelineHorlogeLibelle}"

                                               FontSize="12" Foreground="White" FontWeight="Bold" Margin="0,6,0,0"/>

                                </StackPanel>



                                <!-- Timeline progression réelle -->

                                <Grid Grid.Row="2" Grid.ColumnSpan="2" Margin="0,8,0,0">

                                    <Grid.RowDefinitions>

                                        <RowDefinition Height="Auto"/>

                                        <RowDefinition Height="Auto"/>

                                    </Grid.RowDefinitions>

                                    <Grid Grid.Row="0" Height="12" Margin="0,0,0,10">

                                        <Border Background="#33FFFFFF" CornerRadius="6"/>

                                        <Grid>

                                            <Grid.ColumnDefinitions>

                                                <ColumnDefinition Width="{Binding TimelineProgressStar}"/>

                                                <ColumnDefinition Width="{Binding TimelineResteStar}"/>

                                            </Grid.ColumnDefinitions>

                                            <Border Grid.Column="0" CornerRadius="6" ClipToBounds="True">

                                                <Border.Background>

                                                    <LinearGradientBrush StartPoint="0,0.5" EndPoint="1,0.5">

                                                        <GradientStop Color="#FFFF8A80" Offset="0"/>

                                                        <GradientStop Color="#FFFFFFFF" Offset="1"/>

                                                    </LinearGradientBrush>

                                                </Border.Background>

                                            </Border>

                                            <!-- Curseur collé à la fin réelle du segment (sans décalage) -->

                                            <Ellipse Grid.Column="0" Width="14" Height="14" Fill="White"

                                                     HorizontalAlignment="Right" VerticalAlignment="Center"

                                                     Stroke="#FFE30613" StrokeThickness="2">

                                                <Ellipse.Style>

                                                    <Style TargetType="Ellipse">

                                                        <Setter Property="Visibility" Value="Visible"/>

                                                        <Style.Triggers>

                                                            <DataTrigger Binding="{Binding TimelineProgressPercent}" Value="0">

                                                                <Setter Property="Visibility" Value="Collapsed"/>

                                                            </DataTrigger>

                                                        </Style.Triggers>

                                                    </Style>

                                                </Ellipse.Style>

                                            </Ellipse>

                                        </Grid>

                                    </Grid>

                                    <!-- Repères horaires proportionnels à la journée (pas d’espacement égal) -->

                                    <Grid Grid.Row="1">

                                        <Grid.ColumnDefinitions>

                                            <ColumnDefinition Width="{Binding TimelineSegDebutPauseStar}"/>

                                            <ColumnDefinition Width="{Binding TimelineSegPauseRepriseStar}"/>

                                            <ColumnDefinition Width="{Binding TimelineSegRepriseFinStar}"/>

                                        </Grid.ColumnDefinitions>

                                        <StackPanel Grid.Column="0" HorizontalAlignment="Left">

                                            <TextBlock Text="{Binding HeureDebutTravail}" FontSize="12" FontWeight="SemiBold" Foreground="White"/>

                                            <TextBlock Text="Début" FontSize="11" Foreground="White" FontWeight="Bold"/>

                                        </StackPanel>

                                        <StackPanel Grid.Column="0" HorizontalAlignment="Right" Margin="0,0,-18,0">

                                            <TextBlock Text="{Binding HeureDebutPause}" FontSize="12" FontWeight="SemiBold" Foreground="White" HorizontalAlignment="Center"/>

                                            <TextBlock Text="Pause" FontSize="11" Foreground="White" FontWeight="Bold" HorizontalAlignment="Center"/>

                                        </StackPanel>

                                        <StackPanel Grid.Column="1" HorizontalAlignment="Right" Margin="0,0,-22,0">

                                            <TextBlock Text="{Binding HeureFinPause}" FontSize="12" FontWeight="SemiBold" Foreground="White" HorizontalAlignment="Center"/>

                                            <TextBlock Text="Reprise" FontSize="11" Foreground="White" FontWeight="Bold" HorizontalAlignment="Center"/>

                                        </StackPanel>

                                        <StackPanel Grid.Column="2" HorizontalAlignment="Right">

                                            <TextBlock Text="{Binding HeureFinTravail}" FontSize="12" FontWeight="SemiBold" Foreground="White" HorizontalAlignment="Right"/>

                                            <TextBlock Text="Fin" FontSize="11" Foreground="White" FontWeight="Bold" HorizontalAlignment="Right"/>

                                        </StackPanel>

                                    </Grid>

                                </Grid>

                            </Grid>

                        </Border>



                        <!-- Activité récente -->

                        <Border Grid.Row="3" Style="{StaticResource Card}" Padding="12" Margin="0,0,0,10">

                            <DockPanel>

                                <DockPanel DockPanel.Dock="Top" Margin="4,2,4,10">

                                    <Button DockPanel.Dock="Right" Style="{StaticResource QuietButton}" Content="Voir tout ?"

                                            Command="{Binding NaviguerCommand}" CommandParameter="Présence" Margin="0" Padding="8,4"/>

                                    <TextBlock Text="Activité récente" FontSize="15" FontWeight="SemiBold"

                                               Foreground="{StaticResource BrushText}" VerticalAlignment="Center"/>

                                </DockPanel>



                                <Border Style="{StaticResource MessageBanner}" Margin="8,16"

                                        Visibility="{Binding ActiviteRecenteVide, Converter={StaticResource BoolToVis}}">

                                    <StackPanel>

                                        <TextBlock Text="Aucune activité récente" FontSize="14" FontWeight="SemiBold"

                                                   Foreground="White" HorizontalAlignment="Center"/>

                                        <TextBlock Text="Les nouveaux pointages apparaîtront ici."

                                                   FontSize="12" Foreground="White" FontWeight="Bold" Margin="0,6,0,0"

                                                   HorizontalAlignment="Center"/>

                                    </StackPanel>

                                </Border>



                                <DataGrid ItemsSource="{Binding PointagesRecents}"

                                          Visibility="{Binding ActiviteRecenteVide, Converter={StaticResource InvBoolToVis}}"

                                          HeadersVisibility="Column" RowHeight="48" Margin="0"

                                          VerticalScrollBarVisibility="Auto">

                                    <DataGrid.Columns>

                                        <DataGridTextColumn Header="Heure" Binding="{Binding Horodatage, StringFormat=HH:mm}" Width="70"/>

                                        <DataGridTemplateColumn Header="Employé" Width="*">

                                            <DataGridTemplateColumn.CellTemplate>

                                                <DataTemplate>

                                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">

                                                        <Border Width="30" Height="30" CornerRadius="15" Background="#14000000" Margin="0,0,10,0">

                                                            <TextBlock Text="{Binding Employe.Initiales}" FontSize="10" FontWeight="Bold"

                                                                       Foreground="{StaticResource BrushText}"

                                                                       HorizontalAlignment="Center" VerticalAlignment="Center"/>

                                                        </Border>

                                                        <StackPanel VerticalAlignment="Center">

                                                            <TextBlock Text="{Binding Employe.NomComplet}" FontWeight="SemiBold" Foreground="{StaticResource BrushText}"/>

                                                            <TextBlock Text="{Binding Employe.Matricule}" FontSize="11" Foreground="{StaticResource BrushText}" FontWeight="Bold"/>

                                                        </StackPanel>

                                                    </StackPanel>

                                                </DataTemplate>

                                            </DataGridTemplateColumn.CellTemplate>

                                        </DataGridTemplateColumn>

                                        <DataGridTemplateColumn Header="Type" Width="90">

                                            <DataGridTemplateColumn.CellTemplate>

                                                <DataTemplate>

                                                    <Border CornerRadius="999" Padding="10,4" HorizontalAlignment="Left" Background="#22E30613">

                                                        <TextBlock Text="{Binding TypeLibelle}" FontSize="11" FontWeight="SemiBold"

                                                                   Foreground="{StaticResource BrushAccent}"/>

                                                    </Border>

                                                </DataTemplate>

                                            </DataGridTemplateColumn.CellTemplate>

                                        </DataGridTemplateColumn>

                                        <DataGridTextColumn Header="Source" Binding="{Binding SourceLibelle}" Width="90"/>

                                    </DataGrid.Columns>

                                </DataGrid>

                            </DockPanel>

                        </Border>



                        <!-- Pied message -->

                        <Border Grid.Row="4" Style="{StaticResource MessageBanner}" Padding="12,10" Margin="2,0,2,0">

                            <DockPanel>

                                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">

                                    <TextBlock FontFamily="Segoe MDL2 Assets" Text="&#xE946;" Foreground="White"

                                               FontSize="12" Margin="0,0,6,0" VerticalAlignment="Center"/>

                                    <TextBlock Text="Système opérationnel" FontSize="11" Foreground="White" FontWeight="Bold" Margin="0,0,12,0"/>

                                    <TextBlock Text="v1.0.0" FontSize="11" Foreground="White" FontWeight="Bold"/>

                                </StackPanel>

                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">

                                    <Ellipse Width="8" Height="8" Fill="White" Margin="0,0,8,0"/>

                                    <TextBlock Text="{Binding StatutBarreAffiche}" FontSize="12" Foreground="White" Margin="0,0,14,0"/>

                                    <TextBlock Text="{Binding PiedSyncDetail}" FontSize="11" Foreground="White" FontWeight="Bold"/>

                                </StackPanel>

                            </DockPanel>

                        </Border>

                    </Grid>



                    <!-- Panneau droit -->

                    <StackPanel Grid.Column="1">

                        <Border Style="{StaticResource Card}" Padding="16" Margin="0,0,0,12">

                            <StackPanel>

                                <DockPanel Margin="0,0,0,14">

                                    <Border DockPanel.Dock="Right" Background="#22E30613" CornerRadius="999" Padding="10,4">

                                        <TextBlock Text="{Binding JourneeBadge}" FontSize="11" FontWeight="Bold"

                                                   Foreground="{StaticResource BrushAccent}"/>

                                    </Border>

                                    <TextBlock Text="Statut de la journée" FontSize="13" FontWeight="SemiBold"

                                               Foreground="{StaticResource BrushText}" VerticalAlignment="Center"/>

                                </DockPanel>



                                <StackPanel Orientation="Horizontal" Margin="0,0,0,16">

                                    <Border Width="44" Height="44" CornerRadius="12" Background="#22FFC233" Margin="0,0,12,0">

                                        <TextBlock Text="&#xE706;" FontFamily="Segoe MDL2 Assets" FontSize="20"

                                                   Foreground="{StaticResource BrushWarning}"

                                                   HorizontalAlignment="Center" VerticalAlignment="Center"/>

                                    </Border>

                                    <StackPanel VerticalAlignment="Center">

                                        <TextBlock Text="{Binding HeureActuelle}" FontSize="28" FontWeight="Bold" Foreground="{StaticResource BrushText}"/>

                                        <TextBlock Text="{Binding DateCourteActuelle}" FontSize="12" Foreground="{StaticResource BrushText}" FontWeight="Bold"/>

                                    </StackPanel>

                                </StackPanel>



                                <Border Height="1" Background="{StaticResource BrushStroke}" Margin="0,0,0,12"/>



                                <Grid Margin="0,0,0,8">

                                    <Grid.ColumnDefinitions>

                                        <ColumnDefinition Width="*"/>

                                        <ColumnDefinition Width="Auto"/>

                                    </Grid.ColumnDefinitions>

                                    <TextBlock Text="Heure de début" FontSize="12" Foreground="{StaticResource BrushText}" FontWeight="Bold"/>

                                    <TextBlock Grid.Column="1" Text="{Binding HeureDebutTravail}" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource BrushText}"/>

                                </Grid>

                                <Grid Margin="0,0,0,8">

                                    <Grid.ColumnDefinitions>

                                        <ColumnDefinition Width="*"/>

                                        <ColumnDefinition Width="Auto"/>

                                    </Grid.ColumnDefinitions>

                                    <TextBlock Text="Heure de fin" FontSize="12" Foreground="{StaticResource BrushText}" FontWeight="Bold"/>

                                    <TextBlock Grid.Column="1" Text="{Binding HeureFinTravail}" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource BrushText}"/>

                                </Grid>

                                <Grid Margin="0,0,0,8">

                                    <Grid.ColumnDefinitions>

                                        <ColumnDefinition Width="*"/>

                                        <ColumnDefinition Width="Auto"/>

                                    </Grid.ColumnDefinitions>

                                    <TextBlock Text="Temps écoulé" FontSize="12" Foreground="{StaticResource BrushText}" FontWeight="Bold"/>

                                    <TextBlock Grid.Column="1" Text="{Binding TempsEcouleLibelle}" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource BrushText}"/>

                                </Grid>

                                <Grid>

                                    <Grid.ColumnDefinitions>

                                        <ColumnDefinition Width="*"/>

                                        <ColumnDefinition Width="Auto"/>

                                    </Grid.ColumnDefinitions>

                                    <TextBlock Text="Temps restant" FontSize="12" Foreground="{StaticResource BrushText}" FontWeight="Bold"/>

                                    <TextBlock Grid.Column="1" Text="{Binding TempsRestantLibelle}" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource BrushText}"/>

                                </Grid>

                            </StackPanel>

                        </Border>



                        <Border Style="{StaticResource Card}" Padding="16">

                            <StackPanel>

                                <TextBlock Text="Aperçu rapide" FontSize="13" FontWeight="SemiBold"

                                           Foreground="{StaticResource BrushText}" Margin="0,0,0,14"/>



                                <DockPanel Margin="0,0,0,12">

                                    <Border DockPanel.Dock="Left" Width="28" Height="28" CornerRadius="8" Background="#2235D39A" Margin="0,0,10,0">

                                        <TextBlock Text="&#xE73E;" FontFamily="Segoe MDL2 Assets" Foreground="{StaticResource BrushSuccess}"

                                                   HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="12"/>

                                    </Border>

                                    <TextBlock Text="{Binding CompteurPresents}" DockPanel.Dock="Right" FontWeight="Bold"

                                               Foreground="{StaticResource BrushText}" VerticalAlignment="Center"/>

                                    <TextBlock Text="Présents" Foreground="{StaticResource BrushText}" FontWeight="Bold" VerticalAlignment="Center" FontSize="13"/>

                                </DockPanel>

                                <DockPanel Margin="0,0,0,12">

                                    <Border DockPanel.Dock="Left" Width="28" Height="28" CornerRadius="8" Background="#22FFC233" Margin="0,0,10,0">

                                        <TextBlock Text="&#xE916;" FontFamily="Segoe MDL2 Assets" Foreground="{StaticResource BrushWarning}"

                                                   HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="12"/>

                                    </Border>

                                    <TextBlock Text="{Binding CompteurRetards}" DockPanel.Dock="Right" FontWeight="Bold"

                                               Foreground="{StaticResource BrushText}" VerticalAlignment="Center"/>

                                    <TextBlock Text="Retards" Foreground="{StaticResource BrushText}" FontWeight="Bold" VerticalAlignment="Center" FontSize="13"/>

                                </DockPanel>

                                <DockPanel Margin="0,0,0,12">

                                    <Border DockPanel.Dock="Left" Width="28" Height="28" CornerRadius="8" Background="#22FF6B72" Margin="0,0,10,0">

                                        <TextBlock Text="&#xE711;" FontFamily="Segoe MDL2 Assets" Foreground="{StaticResource BrushDanger}"

                                                   HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="12"/>

                                    </Border>

                                    <TextBlock Text="{Binding CompteurAbsentsOuNonPointes}" DockPanel.Dock="Right" FontWeight="Bold"

                                               Foreground="{StaticResource BrushText}" VerticalAlignment="Center"/>

                                    <TextBlock Text="{Binding LabelAbsentsOuNonPointesCourt}" Foreground="{StaticResource BrushText}" FontWeight="Bold" VerticalAlignment="Center" FontSize="13"/>

                                </DockPanel>

                                <DockPanel>

                                    <Border DockPanel.Dock="Left" Width="28" Height="28" CornerRadius="8" Background="#225B9CFF" Margin="0,0,10,0">

                                        <TextBlock Text="&#xE72A;" FontFamily="Segoe MDL2 Assets" Foreground="{StaticResource BrushInfo}"

                                                   HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="12"/>

                                    </Border>

                                    <TextBlock Text="{Binding CompteurSortis}" DockPanel.Dock="Right" FontWeight="Bold"

                                               Foreground="{StaticResource BrushText}" VerticalAlignment="Center"/>

                                    <TextBlock Text="Sortis" Foreground="{StaticResource BrushText}" FontWeight="Bold" VerticalAlignment="Center" FontSize="13"/>

                                </DockPanel>

                            </StackPanel>

                        </Border>

                    </StackPanel>

                </Grid>



                <!-- Employés -->

                <Grid Visibility="{Binding EstEmployes, Converter={StaticResource BoolToVis}}" Margin="8,4,8,12">

                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="16"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <DockPanel Grid.Column="0">
                        <StackPanel DockPanel.Dock="Top" Margin="0,0,0,12">
                            <TextBlock Style="{StaticResource PageTitle}" Text="Employés" Margin="0,0,0,2"/>
                            <TextBlock Text="Fiches + PIN pointeuse" FontSize="13" FontWeight="Bold"
                                       Foreground="{StaticResource BrushText}" Margin="0,0,0,12"/>

                            <Grid Margin="0,0,0,10">
                                <TextBox MinHeight="36" Padding="12,8"
                                         Text="{Binding FiltreEmploye, UpdateSourceTrigger=PropertyChanged}"/>
                                <TextBlock Text="Rechercher (matricule, nom…)" Foreground="#668D99AE"
                                           Margin="14,0,0,0" VerticalAlignment="Center" IsHitTestVisible="False">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Visibility" Value="Collapsed"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding FiltreEmploye}" Value="">
                                                    <Setter Property="Visibility" Value="Visible"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                            </Grid>

                            <WrapPanel Orientation="Horizontal">
                                <Button Content="Charger liste LT" Style="{StaticResource GhostButton}"
                                        Command="{Binding RechargerEmployesSeedCommand}"
                                        Padding="12,8" MinHeight="36" Margin="0,0,8,8"
                                        ToolTip="Précharger les employés LT livrés avec l'application"/>
                                <Button Content="Importer CSV" Style="{StaticResource GhostButton}"
                                        Command="{Binding ImporterEmployesCsvCommand}"
                                        Padding="12,8" MinHeight="36" Margin="0,0,8,8"
                                        ToolTip="Importer un fichier CSV employés (Matricule;Nom;Postnom;Prenom;PIN)"/>
                                <Button Content="Importer salaires" Style="{StaticResource GhostButton}"
                                        Command="{Binding ImporterFicheSalaireCommand}"
                                        Padding="12,8" MinHeight="36" Margin="0,0,8,8"
                                        ToolTip="Fichier Excel « FICHER DE SALAIRE » — crée aussi les employés manquants"/>
                                <Button Content="Nouveau" Command="{Binding NouvelEmployeCommand}"
                                        Padding="12,8" MinHeight="36" Margin="0,0,8,8"/>
                                <Button Content="Modifier" Style="{StaticResource GhostButton}"
                                        Command="{Binding EditerEmployeCommand}"
                                        Padding="12,8" MinHeight="36" Margin="0,0,8,8"/>
                                <Button Content="Supprimer" Style="{StaticResource DangerButton}"
                                        Command="{Binding SupprimerEmployeCommand}"
                                        Padding="12,8" MinHeight="36" Margin="0,0,0,8"/>
                            </WrapPanel>
                        </StackPanel>

                        <Border Style="{StaticResource Card}" Padding="8">
                            <DataGrid ItemsSource="{Binding Employes}" SelectedItem="{Binding EmployeSelectionne}">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="Matricule" Binding="{Binding Matricule}" Width="110"
                                                        ElementStyle="{StaticResource DataGridCellText}"/>
                                    <DataGridTextColumn Header="Nom" Binding="{Binding Nom}" Width="*"
                                                        ElementStyle="{StaticResource DataGridCellText}"/>
                                    <DataGridTextColumn Header="Prénom" Binding="{Binding Prenom}" Width="130"
                                                        ElementStyle="{StaticResource DataGridCellText}"/>
                                    <DataGridTextColumn Header="ID terminal" Binding="{Binding CodePinZk}" Width="100"
                                                        ElementStyle="{StaticResource DataGridCellText}"/>
                                    <DataGridTextColumn Header="Salaire" Binding="{Binding SalaireMensuel, StringFormat=N2}" Width="110"
                                                        ElementStyle="{StaticResource DataGridCellText}"/>
                                    <DataGridCheckBoxColumn Header="Actif" Binding="{Binding Actif}" Width="70"/>
                                </DataGrid.Columns>
                            </DataGrid>
                        </Border>
                    </DockPanel>

                    <Border Grid.Column="2" Width="360" Style="{StaticResource Card}" Padding="16"
                            VerticalAlignment="Stretch"
                            Visibility="{Binding EmployeEdition, Converter={StaticResource NullToVis}}">
                        <DockPanel LastChildFill="True">
                            <Button DockPanel.Dock="Bottom"
                                    Content="Enregistrer la fiche &amp; paie"
                                    Command="{Binding SauverEmployeCommand}"
                                    Margin="0,16,0,0"
                                    MinHeight="42"
                                    Padding="14,12"
                                    HorizontalAlignment="Stretch"/>

                            <ScrollViewer VerticalScrollBarVisibility="Auto"
                                          HorizontalScrollBarVisibility="Disabled"
                                          CanContentScroll="False">
                                <StackPanel>
                                    <TextBlock Text="Fiche employé" FontSize="18" FontWeight="Bold"
                                               Foreground="{StaticResource BrushText}" Margin="0,0,0,14"/>

                                    <TextBlock Style="{StaticResource FieldLabel}" Text="Matricule"/>
                                    <TextBox Text="{Binding EmployeEdition.Matricule, UpdateSourceTrigger=PropertyChanged}"
                                             Margin="0,0,0,10"/>

                                    <TextBlock Style="{StaticResource FieldLabel}" Text="Nom"/>
                                    <TextBox Text="{Binding EmployeEdition.Nom, UpdateSourceTrigger=PropertyChanged}"
                                             Margin="0,0,0,10"/>

                                    <TextBlock Style="{StaticResource FieldLabel}" Text="Prénom"/>
                                    <TextBox Text="{Binding EmployeEdition.Prenom, UpdateSourceTrigger=PropertyChanged}"
                                             Margin="0,0,0,10"/>

                                    <TextBlock Style="{StaticResource FieldLabel}" Text="ID utilisateur terminal (ZKTeco)"/>
                                    <TextBox Text="{Binding EmployeEdition.CodePinZk, UpdateSourceTrigger=PropertyChanged}"
                                             Margin="0,0,0,6"/>
                                    <TextBlock Text="Lien employé ↔ enrôlement pointeuse (comme Melody Paie)."
                                               FontSize="11" Opacity="0.7" TextWrapping="Wrap" Margin="0,0,0,8"/>
                                    <WrapPanel Orientation="Horizontal" Margin="0,0,0,6">
                                        <Button Content="Lire IDs terminal"
                                                Command="{Binding ChargerIdsTerminalCommand}"
                                                Style="{StaticResource GhostButton}"
                                                Padding="10,6" Margin="0,0,6,6"/>
                                        <Button Content="Attribuer ID sélectionné"
                                                Command="{Binding AttribuerIdTerminalCommand}"
                                                Style="{StaticResource GhostButton}"
                                                Padding="10,6" Margin="0,0,6,6"/>
                                        <Button Content="Associer auto"
                                                Command="{Binding AssocierIdsTerminalAutoCommand}"
                                                Style="{StaticResource GhostButton}"
                                                Padding="10,6" Margin="0,0,0,6"
                                                ToolTip="Lie automatiquement ID terminal ↔ employé (matricule ou nom)"/>
                                    </WrapPanel>
                                    <Border BorderBrush="#CFD8DC" BorderThickness="1" CornerRadius="8"
                                            Padding="4" Margin="0,0,0,12" Background="#FAFCFE"
                                            MaxHeight="120">
                                        <ListBox ItemsSource="{Binding IdsTerminalDetectes}"
                                                 SelectedItem="{Binding IdTerminalSelectionne, Mode=TwoWay}"
                                                 BorderThickness="0" Background="Transparent"
                                                 DisplayMemberPath="Affichage"/>
                                    </Border>

                                    <CheckBox Content="Actif" IsChecked="{Binding EmployeEdition.Actif}" Margin="0,0,0,14"/>

                                    <TextBlock Text="DONNÉES DE PAIE (A PAYER)" Style="{StaticResource SectionLabel}" Margin="0,4,0,10"/>
                                    <TextBlock Text="Montants journaliers utilisés sur le bulletin."
                                               FontSize="11" FontWeight="Bold" Foreground="{StaticResource BrushText}"
                                               Opacity="0.75" Margin="0,0,0,10" TextWrapping="Wrap"/>

                                    <TextBlock Style="{StaticResource FieldLabel}" Text="Salaire mensuel"/>
                                    <TextBox Text="{Binding EmployeEdition.SalaireMensuel, UpdateSourceTrigger=PropertyChanged}"
                                             Margin="0,0,0,6"/>
                                    <Button Content="Calculer taux base (÷ 26)"
                                            Style="{StaticResource GhostButton}"
                                            Command="{Binding RecalculerTauxBaseCommand}"
                                            Margin="0,0,0,12" Padding="10,6" MinHeight="32"
                                            HorizontalAlignment="Left"/>

                                    <TextBlock Style="{StaticResource FieldLabel}" Text="Taux salaire de base / jour"/>
                                    <TextBox Text="{Binding EmployeEdition.TauxSalaireBase, UpdateSourceTrigger=PropertyChanged}"
                                             Margin="0,0,0,10"/>

                                    <TextBlock Style="{StaticResource FieldLabel}" Text="Taux ancienneté / jour"/>
                                    <TextBox Text="{Binding EmployeEdition.TauxAnciennete, UpdateSourceTrigger=PropertyChanged}"
                                             Margin="0,0,0,10"/>

                                    <TextBlock Style="{StaticResource FieldLabel}" Text="Taux transport / jour"/>
                                    <TextBox Text="{Binding EmployeEdition.TauxTransport, UpdateSourceTrigger=PropertyChanged}"
                                             Margin="0,0,0,10"/>

                                    <TextBlock Style="{StaticResource FieldLabel}" Text="Taux logement / jour"/>
                                    <TextBox Text="{Binding EmployeEdition.TauxLogement, UpdateSourceTrigger=PropertyChanged}"
                                             Margin="0,0,0,10"/>

                                    <TextBlock Style="{StaticResource FieldLabel}" Text="Taux allocations familiales / jour"/>
                                    <TextBox Text="{Binding EmployeEdition.TauxAllocFamiliales, UpdateSourceTrigger=PropertyChanged}"
                                             Margin="0,0,0,10"/>

                                    <TextBlock Style="{StaticResource FieldLabel}" Text="Taux indemnité KM"/>
                                    <TextBox Text="{Binding EmployeEdition.TauxIndemniteKm, UpdateSourceTrigger=PropertyChanged}"
                                             Margin="0,0,0,10"/>

                                    <TextBlock Style="{StaticResource FieldLabel}" Text="Taux prime d'assiduité"/>
                                    <TextBox Text="{Binding EmployeEdition.TauxPrimeAssiduite, UpdateSourceTrigger=PropertyChanged}"
                                             Margin="0,0,0,10"/>

                                    <TextBlock Style="{StaticResource FieldLabel}" Text="Taux jour de maladie"/>
                                    <TextBox Text="{Binding EmployeEdition.TauxJourMaladie, UpdateSourceTrigger=PropertyChanged}"
                                             Margin="0,0,0,10"/>

                                    <TextBlock Style="{StaticResource FieldLabel}" Text="Taux jour férié presté"/>
                                    <TextBox Text="{Binding EmployeEdition.TauxJourFerie, UpdateSourceTrigger=PropertyChanged}"
                                             Margin="0,0,0,10"/>

                                    <TextBlock Style="{StaticResource FieldLabel}" Text="Taux complément transport"/>
                                    <TextBox Text="{Binding EmployeEdition.TauxComplementTransport, UpdateSourceTrigger=PropertyChanged}"
                                             Margin="0,0,0,8"/>
                                </StackPanel>
                            </ScrollViewer>
                        </DockPanel>
                    </Border>

                </Grid>



                <!-- Présence -->

                <Grid Visibility="{Binding EstPresence, Converter={StaticResource BoolToVis}}" Margin="2,0,2,0">

                    <Grid.RowDefinitions>

                        <RowDefinition Height="Auto"/>

                        <RowDefinition Height="Auto"/>

                        <RowDefinition Height="Auto"/>

                        <RowDefinition Height="*"/>

                    </Grid.RowDefinitions>



                    <!-- Header -->

                    <DockPanel Grid.Row="0" Margin="4,2,4,14">

                        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">

                            <Border Background="#FFE4E7EC" CornerRadius="10" Padding="3" Margin="0,0,10,0"

                                    BorderBrush="{StaticResource BrushStroke}" BorderThickness="1">

                                <StackPanel Orientation="Horizontal">

                                    <Button Style="{StaticResource QuietButton}" Content="‹" FontSize="16"

                                            Command="{Binding JourPrecedentCommand}" Margin="0" Padding="12,6"

                                            ToolTip="Jour précédent"/>

                                    <Button Style="{StaticResource QuietButton}" Content="Aujourd'hui"

                                            Command="{Binding JourAujourdhuiCommand}" Margin="0" Padding="12,6"/>

                                    <Button Style="{StaticResource QuietButton}" Content="›" FontSize="16"

                                            Command="{Binding JourSuivantCommand}" Margin="0" Padding="12,6"

                                            ToolTip="Jour suivant"/>

                                </StackPanel>

                            </Border>



                            <Button Style="{StaticResource GhostButton}" Content="Exporter ?" Margin="0,0,8,0"

                                    Click="ExporterPresence_Click" ToolTip="Exporter les données du jour"/>

                            <Button Command="{Binding SynchroniserZkCommand}" Padding="14,10" Margin="0"

                                    ToolTip="Synchroniser la pointeuse">

                                <StackPanel Orientation="Horizontal">

                                    <TextBlock FontFamily="Segoe MDL2 Assets" Text="&#xE895;" Margin="0,0,8,0" VerticalAlignment="Center"/>

                                    <TextBlock Text="Synchroniser"/>

                                </StackPanel>

                            </Button>

                        </StackPanel>

                        <StackPanel>

                            <TextBlock Style="{StaticResource PageTitle}" Text="Présence" Margin="0,0,0,2"/>

                            <TextBlock Text="{Binding DatePresenceLibelle}" Foreground="{StaticResource BrushText}" FontWeight="Bold" FontSize="14"/>

                        </StackPanel>

                    </DockPanel>



                    <!-- Alerte terminal -->

                    <Border Grid.Row="1" Margin="4,0,4,12" Style="{StaticResource MessageBanner}"

                            Visibility="{Binding TerminalAlerteVisible, Converter={StaticResource BoolToVis}}">

                        <DockPanel>

                            <Button DockPanel.Dock="Right" Content="Configurer maintenant"

                                    Command="{Binding ConfigurerTerminalCommand}" Margin="12,0,0,0"

                                    Background="White" Foreground="#FFE30613"/>

                            <StackPanel>

                                <TextBlock Text="? Configuration requise" FontWeight="SemiBold"

                                           Foreground="White" FontSize="13"/>

                                <TextBlock Text="Le terminal de pointage n'est pas configuré."

                                           Foreground="White" FontWeight="Bold" FontSize="12" Margin="0,3,0,0"/>

                            </StackPanel>

                        </DockPanel>

                    </Border>



                    <!-- KPI -->

                    <UniformGrid Grid.Row="2" Columns="4" Margin="4,0,4,12"

                                 Visibility="{Binding PresenceListeAgrandie, Converter={StaticResource InvBoolToVis}}">

                        <Border Style="{StaticResource StatCard}" Cursor="Hand" Margin="0,0,10,0">

                            <Border.InputBindings>

                                <MouseBinding Gesture="LeftClick" Command="{Binding FiltrerStatutCommand}" CommandParameter="Parti"/>

                            </Border.InputBindings>

                            <DockPanel>

                                <Border DockPanel.Dock="Right" Width="32" Height="32" CornerRadius="8" Background="#2235D39A">

                                    <TextBlock Text="&#xE73E;" FontFamily="Segoe MDL2 Assets" Foreground="{StaticResource BrushSuccess}"

                                               HorizontalAlignment="Center" VerticalAlignment="Center"/>

                                </Border>

                                <StackPanel>

                                    <TextBlock Text="PRÉSENTS" FontSize="11" FontWeight="Bold" Foreground="{StaticResource BrushText}"/>

                                    <TextBlock Text="{Binding CompteurPresents}" FontSize="32" FontWeight="Bold"

                                               Foreground="{StaticResource BrushText}" Margin="0,4,0,0"/>

                                    <TextBlock Text="{Binding CompteurPresentsContexte}" FontSize="11" Foreground="{StaticResource BrushText}" FontWeight="Bold"/>

                                </StackPanel>

                            </DockPanel>

                        </Border>

                        <Border Style="{StaticResource StatCard}" Cursor="Hand" Margin="0,0,10,0">

                            <Border.InputBindings>

                                <MouseBinding Gesture="LeftClick" Command="{Binding FiltrerStatutCommand}" CommandParameter="Retard"/>

                            </Border.InputBindings>

                            <DockPanel>

                                <Border DockPanel.Dock="Right" Width="32" Height="32" CornerRadius="8" Background="#22FFC233">

                                    <TextBlock Text="&#xE916;" FontFamily="Segoe MDL2 Assets" Foreground="{StaticResource BrushWarning}"

                                               HorizontalAlignment="Center" VerticalAlignment="Center"/>

                                </Border>

                                <StackPanel>

                                    <TextBlock Text="RETARDS" FontSize="11" FontWeight="Bold" Foreground="{StaticResource BrushText}"/>

                                    <TextBlock Text="{Binding CompteurRetards}" FontSize="32" FontWeight="Bold"

                                               Foreground="{StaticResource BrushText}" Margin="0,4,0,0"/>

                                    <TextBlock Text="{Binding CompteurRetardsContexte}" FontSize="11" Foreground="{StaticResource BrushText}" FontWeight="Bold"/>

                                </StackPanel>

                            </DockPanel>

                        </Border>

                        <Border Style="{StaticResource StatCard}" Cursor="Hand" Margin="0,0,10,0">

                            <Border.InputBindings>

                                <MouseBinding Gesture="LeftClick" Command="{Binding FiltrerStatutCommand}" CommandParameter="En cours"/>

                            </Border.InputBindings>

                            <DockPanel>

                                <Border DockPanel.Dock="Right" Width="32" Height="32" CornerRadius="8" Background="#225B9CFF">

                                    <TextBlock Text="&#xE121;" FontFamily="Segoe MDL2 Assets" Foreground="{StaticResource BrushInfo}"

                                               HorizontalAlignment="Center" VerticalAlignment="Center"/>

                                </Border>

                                <StackPanel>

                                    <TextBlock Text="EN COURS" FontSize="11" FontWeight="Bold" Foreground="{StaticResource BrushText}"/>

                                    <TextBlock Text="{Binding CompteurEnCours}" FontSize="32" FontWeight="Bold"

                                               Foreground="{StaticResource BrushText}" Margin="0,4,0,0"/>

                                    <TextBlock Text="{Binding CompteurEnCoursContexte}" FontSize="11" Foreground="{StaticResource BrushText}" FontWeight="Bold"/>

                                </StackPanel>

                            </DockPanel>

                        </Border>

                        <Border Style="{StaticResource StatCard}" Cursor="Hand" Margin="0">

                            <Border.InputBindings>

                                <MouseBinding Gesture="LeftClick" Command="{Binding FiltrerStatutCommand}" CommandParameter="AbsentsAuto"/>

                            </Border.InputBindings>

                            <DockPanel>

                                <Border DockPanel.Dock="Right" Width="32" Height="32" CornerRadius="8" Background="#22FF6B72">

                                    <TextBlock Text="&#xE711;" FontFamily="Segoe MDL2 Assets" Foreground="{StaticResource BrushDanger}"

                                               HorizontalAlignment="Center" VerticalAlignment="Center"/>

                                </Border>

                                <StackPanel>

                                    <TextBlock Text="{Binding LabelAbsentsOuNonPointes}" FontSize="11" FontWeight="Bold" Foreground="{StaticResource BrushText}"/>

                                    <TextBlock Text="{Binding CompteurAbsentsOuNonPointes}" FontSize="32" FontWeight="Bold"

                                               Foreground="{StaticResource BrushText}" Margin="0,4,0,0"/>

                                    <TextBlock Text="{Binding CompteurAbsentsContexte}" FontSize="11" Foreground="{StaticResource BrushText}" FontWeight="Bold"/>

                                </StackPanel>

                            </DockPanel>

                        </Border>

                    </UniformGrid>



                    <!-- Liste + panneau -->

                    <Grid Grid.Row="3" Margin="4,0,4,0">

                        <Grid.ColumnDefinitions>

                            <ColumnDefinition Width="*"/>

                            <ColumnDefinition>

                                <ColumnDefinition.Style>

                                    <Style TargetType="ColumnDefinition">

