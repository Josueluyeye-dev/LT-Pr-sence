                                    FontWeight="Bold" Padding="16,10" Margin="12,0,0,0"
                                    MinHeight="36" VerticalAlignment="Center"
                                    Content="Vérifier les mises à jour"
                                    ToolTip="Consulte le serveur GitHub pour une nouvelle version"/>
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Text="MISE À JOUR" Foreground="#CCFFFFFF" FontSize="11" FontWeight="Bold"/>
                                <TextBlock Text="{Binding VersionApplication, StringFormat=LT Présence v{0}}"
                                           Foreground="White" FontSize="16" FontWeight="Bold" Margin="0,2,0,0"/>
                                <TextBlock Text="{Binding MessageMiseAJour}" Foreground="White" FontSize="12"
                                           FontWeight="Bold" Margin="0,4,0,0" TextWrapping="Wrap"/>
                            </StackPanel>
                        </DockPanel>
                    </Border>



                    <!-- Bannière statut terminal -->

                    <Border Grid.Row="2" Style="{StaticResource MessageBanner}" Margin="0,0,0,14">

                        <DockPanel>

                            <Ellipse DockPanel.Dock="Left" Width="10" Height="10" Margin="0,4,12,0"

                                     VerticalAlignment="Top" Fill="White"/>

                            <StackPanel>

                                <TextBlock Text="{Binding TerminalCarteTitre}" FontSize="13" FontWeight="SemiBold"

                                           Foreground="White"/>

                                <TextBlock FontSize="12" Foreground="White" FontWeight="Bold" Margin="0,3,0,0" TextWrapping="Wrap">

                                    <TextBlock.Style>

                                        <Style TargetType="TextBlock">

                                            <Setter Property="Text" Value="Saisissez l’adresse IP du terminal ZKTeco sur le même réseau, puis Enregistrer et Tester."/>

                                            <Style.Triggers>

                                                <DataTrigger Binding="{Binding TerminalConfigure}" Value="True">

                                                    <Setter Property="Text" Value="Terminal prêt. Vous pouvez lancer une synchronisation ou activer la sync automatique."/>

                                                </DataTrigger>

                                            </Style.Triggers>

                                        </Style>

                                    </TextBlock.Style>

                                </TextBlock>

                            </StackPanel>

                        </DockPanel>

                    </Border>



                    <Grid Grid.Row="3">

                        <Grid.ColumnDefinitions>

                            <ColumnDefinition Width="1.05*" MinWidth="300"/>

                            <ColumnDefinition Width="14"/>

                            <ColumnDefinition Width="1.2*" MinWidth="340"/>

                        </Grid.ColumnDefinitions>



                        <!-- Entreprise & journée -->

                        <Border Grid.Column="0" Style="{StaticResource Card}" Padding="18" VerticalAlignment="Top">

                            <StackPanel>

                                <TextBlock Text="Entreprise &amp; journée" FontSize="15" FontWeight="SemiBold"

                                           Foreground="{StaticResource BrushText}" Margin="0,0,0,16"/>



                                <TextBlock Style="{StaticResource FieldLabel}" Text="Nom de l'entreprise"/>

                                <TextBox Text="{Binding NomEntreprise, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,14"/>



                                <TextBlock Text="HORAIRES DE PRÉSENCE" Style="{StaticResource SectionLabel}" Margin="0,4,0,10"/>

                                <Grid>

                                    <Grid.ColumnDefinitions>

                                        <ColumnDefinition Width="*"/>

                                        <ColumnDefinition Width="10"/>

                                        <ColumnDefinition Width="*"/>

                                        <ColumnDefinition Width="10"/>

                                        <ColumnDefinition Width="*"/>

                                    </Grid.ColumnDefinitions>

                                    <StackPanel Grid.Column="0">

                                        <TextBlock Style="{StaticResource FieldLabel}" Text="Heure d'arrivée"/>

                                        <TextBox Text="{Binding HeureDebutTravail, UpdateSourceTrigger=PropertyChanged}" Margin="0"/>

                                    </StackPanel>

                                    <StackPanel Grid.Column="2">

                                        <TextBlock Style="{StaticResource FieldLabel}" Text="Retard après"/>

                                        <TextBox Text="{Binding HeureLimiteTolerance, UpdateSourceTrigger=PropertyChanged}" Margin="0"/>

                                    </StackPanel>

                                    <StackPanel Grid.Column="4">

                                        <TextBlock Style="{StaticResource FieldLabel}" Text="Fin de journée"/>

                                        <TextBox Text="{Binding HeureFinTravail, UpdateSourceTrigger=PropertyChanged}" Margin="0"/>

                                    </StackPanel>

                                </Grid>



                                <TextBlock Text="NOTIFICATIONS &amp; DÉMARRAGE" Style="{StaticResource SectionLabel}" Margin="0,18,0,10"/>

                                <Border Background="#FFE4E7EC" CornerRadius="10" Padding="12,10"

                                        BorderBrush="{StaticResource BrushStroke}" BorderThickness="1">

                                    <StackPanel>

                                        <CheckBox Content="Notifications Windows" IsChecked="{Binding NotificationsWindowsActives}" Margin="0"/>

                                        <TextBlock Text="Toasts cinéma rouge→noir + son pour les sync ZK"

                                                   FontSize="11" Foreground="{StaticResource BrushText}" FontWeight="Bold"

                                                   Margin="26,6,0,0" TextWrapping="Wrap"/>

                                        <Button Content="▶  Aperçu notification LT"

                                                Command="{Binding TesterNotificationCommand}"

                                                Margin="0,12,0,0" HorizontalAlignment="Left"

                                                Padding="14,8" MinHeight="34"/>

                                        <CheckBox Content="Démarrer avec Windows" IsChecked="{Binding DemarrerAvecWindows}" Margin="0,12,0,0"/>

                                        <TextBlock Text="Ouverture automatique à l’allumage du PC (reste en arrière-plan)"

                                                   FontSize="11" Foreground="{StaticResource BrushText}" FontWeight="Bold"

                                                   Margin="26,6,0,0" TextWrapping="Wrap"/>

                                        <TextBlock Text="Fermer la fenêtre masque l’app dans la zone de notification (Quitter via l’icône)."

                                                   FontSize="11" Foreground="{StaticResource BrushText}" FontWeight="Bold"

                                                   Margin="0,12,0,0" TextWrapping="Wrap"/>

                                    </StackPanel>

                                </Border>
</StackPanel>

                        </Border>



                        <!-- ZKTeco -->

                        <Border Grid.Column="2" Style="{StaticResource Card}" Padding="18" VerticalAlignment="Top">

                            <DockPanel>

                                <DockPanel DockPanel.Dock="Top" Margin="0,0,0,16">

                                    <Border DockPanel.Dock="Left" Width="40" Height="40" CornerRadius="11"

                                            Background="#22E30613" Margin="0,0,12,0">

                                        <TextBlock Text="&#xE968;" FontFamily="Segoe MDL2 Assets" FontSize="18"

                                                   Foreground="{StaticResource BrushAccent}"

                                                   HorizontalAlignment="Center" VerticalAlignment="Center"/>

                                    </Border>

                                    <StackPanel VerticalAlignment="Center">

                                        <TextBlock Text="Pointeuse ZKTeco" FontSize="15" FontWeight="SemiBold"

                                                   Foreground="{StaticResource BrushText}"/>

                                        <TextBlock Text="{Binding ZkPortSousTitre}" FontSize="11"

                                                   Foreground="{StaticResource BrushText}" FontWeight="Bold"/>

                                    </StackPanel>

                                </DockPanel>



                                <StackPanel>

                                    <TextBlock Style="{StaticResource FieldLabel}" Text="Adresse IP du terminal"/>

                                    <Grid Margin="0,0,0,12">

                                        <TextBox Text="{Binding ZkIp, UpdateSourceTrigger=PropertyChanged}" Margin="0"

                                                 Padding="12,11" FontSize="14"/>

                                        <TextBlock Text="ex. 192.168.1.201" Foreground="#668D99AE" Margin="14,0,0,0"

                                                   VerticalAlignment="Center" IsHitTestVisible="False">

                                            <TextBlock.Style>

                                                <Style TargetType="TextBlock">

                                                    <Setter Property="Visibility" Value="Collapsed"/>

                                                    <Style.Triggers>

                                                        <DataTrigger Binding="{Binding ZkIp}" Value="">

                                                            <Setter Property="Visibility" Value="Visible"/>

                                                        </DataTrigger>

                                                    </Style.Triggers>

                                                </Style>

                                            </TextBlock.Style>

                                        </TextBlock>

                                    </Grid>



                                    <Grid Margin="0,0,0,12">

                                        <Grid.ColumnDefinitions>

                                            <ColumnDefinition Width="*"/>

                                            <ColumnDefinition Width="10"/>

                                            <ColumnDefinition Width="*"/>

                                            <ColumnDefinition Width="10"/>

                                            <ColumnDefinition Width="*"/>

                                        </Grid.ColumnDefinitions>

                                        <StackPanel Grid.Column="0">

                                            <TextBlock Style="{StaticResource FieldLabel}" Text="Port"/>

                                            <TextBox Text="{Binding ZkPort, UpdateSourceTrigger=PropertyChanged}" Margin="0"/>

                                        </StackPanel>

                                        <StackPanel Grid.Column="2">

                                            <TextBlock Style="{StaticResource FieldLabel}" Text="N° machine"/>

                                            <TextBox Text="{Binding ZkMachine, UpdateSourceTrigger=PropertyChanged}" Margin="0"/>

                                        </StackPanel>

                                        <StackPanel Grid.Column="4">

                                            <TextBlock Style="{StaticResource FieldLabel}" Text="Intervalle (s)"/>

                                            <TextBox Text="{Binding ZkIntervalle, UpdateSourceTrigger=PropertyChanged}"

                                                     IsEnabled="{Binding ZkSyncActif}" Margin="0"/>

                                        </StackPanel>

                                    </Grid>



                                    <TextBlock Style="{StaticResource FieldLabel}" Text="Mot de passe communication PC"/>

                                    <TextBox Text="{Binding ZkCommPwd, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,14"/>



                                    <Border Background="#FFE4E7EC" CornerRadius="10" Padding="12,10" Margin="0,0,0,14"

                                            BorderBrush="{StaticResource BrushStroke}" BorderThickness="1">

                                        <CheckBox Content="Synchronisation automatique" IsChecked="{Binding ZkSyncActif}" Margin="0"/>

                                    </Border>



                                    <TextBlock FontSize="12" Foreground="{StaticResource BrushText}" FontWeight="Bold" TextWrapping="Wrap"

                                               Text="Astuce : l’IP se lit dans le menu réseau de la pointeuse (Comm. ? Ethernet). PC et terminal doivent être sur le même LAN."/>

                                </StackPanel>

                            </DockPanel>

                        </Border>

                    </Grid>

                </Grid>

                </ScrollViewer>

            </Grid>

            </Border>

        </Grid>



        <!-- Toast in-app cinéma (masqué sur Dashboard qui a son propre pied) -->

        <Border VerticalAlignment="Bottom" HorizontalAlignment="Left" Margin="244,0,18,16"

                Style="{StaticResource MessageBanner}" MaxWidth="560" Padding="0"

                Effect="{StaticResource GlassShadow}"

                Visibility="{Binding EstAccueil, Converter={StaticResource InvBoolToVis}}">

            <Grid>

                <Border Height="3" VerticalAlignment="Top"

                        Background="White" Opacity="0.35"/>

                <DockPanel Margin="14,14,16,14">

                    <Border DockPanel.Dock="Left" Width="40" Height="40" CornerRadius="20"

                            Background="#33FFFFFF" BorderBrush="#66FFFFFF" BorderThickness="1"

                            Margin="0,0,12,0" VerticalAlignment="Center">

                        <TextBlock Text="&#xE7E7;" FontFamily="Segoe MDL2 Assets"

                                   Foreground="White" FontSize="16" FontWeight="Bold"

                                   HorizontalAlignment="Center" VerticalAlignment="Center"/>

                    </Border>

                    <StackPanel VerticalAlignment="Center">

                        <TextBlock Text="LT SERVICES · PRÉSENCE"

                                   Foreground="#CCFFFFFF" FontSize="10" FontWeight="Bold"

                                   Margin="0,0,0,2"/>

                        <TextBlock Text="{Binding StatutBarreAffiche}" Foreground="White"

                                   FontSize="13" FontWeight="Bold" TextWrapping="Wrap"/>

                    </StackPanel>

                </DockPanel>

            </Grid>

        </Border>

    </Grid>

</Window>

