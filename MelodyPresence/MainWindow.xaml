<Window x:Class="MelodyPresence.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:MelodyPresence.ViewModels"
        Title="Melody Présence"
        Height="720" Width="1100"
        MinHeight="600" MinWidth="900"
        WindowStartupLocation="CenterScreen"
        Background="#F8FAFC">
    <Window.DataContext>
        <vm:MainViewModel/>
    </Window.DataContext>

    <DockPanel>
        <Border DockPanel.Dock="Bottom" Background="#134E4A" Padding="12,8">
            <TextBlock Text="{Binding StatutBarre}" Foreground="White" FontSize="12"/>
        </Border>

        <Border DockPanel.Dock="Left" Width="200" Background="#CCFBF1">
            <DockPanel>
                <StackPanel DockPanel.Dock="Top" Margin="16,24,16,16">
                    <TextBlock Text="Melody" FontSize="22" FontWeight="Bold" Foreground="#134E4A"/>
                    <TextBlock Text="Présence" FontSize="18" Foreground="#0F766E" Margin="0,0,0,16"/>
                    <Button Style="{StaticResource NavButton}" Content="Accueil" Command="{Binding NaviguerCommand}" CommandParameter="Accueil"/>
                    <Button Style="{StaticResource NavButton}" Content="Employés" Command="{Binding NaviguerCommand}" CommandParameter="Employés"/>
                    <Button Style="{StaticResource NavButton}" Content="Présence du jour" Command="{Binding NaviguerCommand}" CommandParameter="Présence"/>
                    <Button Style="{StaticResource NavButton}" Content="Rapports" Command="{Binding NaviguerCommand}" CommandParameter="Rapports"/>
                    <Button Style="{StaticResource NavButton}" Content="Paramètres" Command="{Binding NaviguerCommand}" CommandParameter="Paramètres"/>
                </StackPanel>
                <TextBlock DockPanel.Dock="Bottom" Margin="16" FontSize="11" Foreground="#5EEAD4"
                           Text="V1.0.0 — modules à venir"/>
            </DockPanel>
        </Border>

        <Grid Margin="24">
            <!-- Accueil -->
            <ScrollViewer Visibility="{Binding EstAccueil, Converter={StaticResource BoolToVis}}">
                <StackPanel>
                    <TextBlock Text="Tableau de bord" FontSize="24" FontWeight="Bold" Foreground="#0F172A" Margin="0,0,0,16"/>
                    <UniformGrid Columns="4" Margin="0,0,0,20">
                        <Border Background="White" CornerRadius="12" Padding="16" Margin="0,0,12,0" BorderBrush="#E2E8F0" BorderThickness="1">
                            <StackPanel>
                                <TextBlock Text="Employés actifs" Foreground="#64748B"/>
                                <TextBlock Text="{Binding CompteurEmployesActifs}" FontSize="28" FontWeight="Bold" Foreground="#0F766E"/>
                            </StackPanel>
                        </Border>
                        <Border Background="White" CornerRadius="12" Padding="16" Margin="0,0,12,0" BorderBrush="#E2E8F0" BorderThickness="1">
                            <StackPanel>
                                <TextBlock Text="Présents" Foreground="#64748B"/>
                                <TextBlock Text="{Binding CompteurPresents}" FontSize="28" FontWeight="Bold" Foreground="#16A34A"/>
                            </StackPanel>
                        </Border>
                        <Border Background="White" CornerRadius="12" Padding="16" Margin="0,0,12,0" BorderBrush="#E2E8F0" BorderThickness="1">
                            <StackPanel>
                                <TextBlock Text="En cours" Foreground="#64748B"/>
                                <TextBlock Text="{Binding CompteurEnCours}" FontSize="28" FontWeight="Bold" Foreground="#D97706"/>
                            </StackPanel>
                        </Border>
                        <Border Background="White" CornerRadius="12" Padding="16" BorderBrush="#E2E8F0" BorderThickness="1">
                            <StackPanel>
                                <TextBlock Text="Absents" Foreground="#64748B"/>
                                <TextBlock Text="{Binding CompteurAbsents}" FontSize="28" FontWeight="Bold" Foreground="#DC2626"/>
                            </StackPanel>
                        </Border>
                    </UniformGrid>
                    <DockPanel Margin="0,0,0,12">
                        <Button DockPanel.Dock="Right" Content="Synchroniser pointeuse" Command="{Binding SynchroniserZkCommand}"/>
                        <TextBlock Text="Derniers pointages" FontSize="18" FontWeight="SemiBold" VerticalAlignment="Center"/>
                    </DockPanel>
                    <DataGrid ItemsSource="{Binding PointagesRecents}" Height="320">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Heure" Binding="{Binding Horodatage, StringFormat=dd/MM HH:mm:ss}" Width="120"/>
                            <DataGridTextColumn Header="Employé" Binding="{Binding Employe.NomComplet}" Width="*"/>
                            <DataGridTextColumn Header="Type" Binding="{Binding Type}" Width="80"/>
                            <DataGridTextColumn Header="Source" Binding="{Binding Source}" Width="90"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </StackPanel>
            </ScrollViewer>

            <!-- Employés -->
            <Grid Visibility="{Binding EstEmployes, Converter={StaticResource BoolToVis}}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="320"/>
                </Grid.ColumnDefinitions>
                <DockPanel Grid.Column="0" Margin="0,0,16,0">
                    <DockPanel DockPanel.Dock="Top" Margin="0,0,0,12">
                        <Button DockPanel.Dock="Right" Content="Nouveau" Command="{Binding NouvelEmployeCommand}"/>
                        <Button DockPanel.Dock="Right" Content="Modifier" Command="{Binding EditerEmployeCommand}"/>
                        <Button DockPanel.Dock="Right" Content="Supprimer" Command="{Binding SupprimerEmployeCommand}" Background="#B91C1C"/>
                        <TextBox Width="220" Text="{Binding FiltreEmploye, UpdateSourceTrigger=PropertyChanged}"
                                 Tag="Rechercher…" VerticalAlignment="Center"/>
                    </DockPanel>
                    <TextBlock DockPanel.Dock="Top" Text="Employés" FontSize="24" FontWeight="Bold" Margin="0,0,0,12"/>
                    <DataGrid ItemsSource="{Binding Employes}" SelectedItem="{Binding EmployeSelectionne}">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Matricule" Binding="{Binding Matricule}" Width="100"/>
                            <DataGridTextColumn Header="Nom" Binding="{Binding Nom}" Width="*"/>
                            <DataGridTextColumn Header="Prénom" Binding="{Binding Prenom}" Width="120"/>
                            <DataGridTextColumn Header="PIN ZK" Binding="{Binding CodePinZk}" Width="80"/>
                            <DataGridCheckBoxColumn Header="Actif" Binding="{Binding Actif}" Width="60"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </DockPanel>
                <Border Grid.Column="1" Background="White" CornerRadius="12" Padding="16" BorderBrush="#E2E8F0" BorderThickness="1"
                        Visibility="{Binding EmployeEdition, Converter={StaticResource NullToVis}}">
                    <StackPanel>
                        <TextBlock Text="Fiche employé" FontSize="18" FontWeight="Bold" Margin="0,0,0,12"/>
                        <TextBlock Text="Matricule"/>
                        <TextBox Text="{Binding EmployeEdition.Matricule, UpdateSourceTrigger=PropertyChanged}"/>
                        <TextBlock Text="Nom"/>
                        <TextBox Text="{Binding EmployeEdition.Nom, UpdateSourceTrigger=PropertyChanged}"/>
                        <TextBlock Text="Prénom"/>
                        <TextBox Text="{Binding EmployeEdition.Prenom, UpdateSourceTrigger=PropertyChanged}"/>
                        <TextBlock Text="Code PIN pointeuse"/>
                        <TextBox Text="{Binding EmployeEdition.CodePinZk, UpdateSourceTrigger=PropertyChanged}"/>
                        <CheckBox Content="Actif" IsChecked="{Binding EmployeEdition.Actif}" Margin="0,8"/>
                        <Button Content="Enregistrer" Command="{Binding SauverEmployeCommand}" Margin="0,16,0,0"/>
                    </StackPanel>
                </Border>
            </Grid>

            <!-- Présence -->
            <DockPanel Visibility="{Binding EstPresence, Converter={StaticResource BoolToVis}}">
                <DockPanel DockPanel.Dock="Top" Margin="0,0,0,12">
                    <TextBlock DockPanel.Dock="Left" Text="Présence du jour" FontSize="24" FontWeight="Bold" VerticalAlignment="Center" Margin="0,0,16,0"/>
                    <DatePicker SelectedDate="{Binding DatePresence}" Width="140" VerticalAlignment="Center" Margin="0,0,12,0"/>
                    <Button Content="Entrée manuelle" Command="{Binding PointerEntreeCommand}"/>
                    <Button Content="Sortie manuelle" Command="{Binding PointerSortieCommand}" Background="#0369A1"/>
                    <Button Content="Sync pointeuse" Command="{Binding SynchroniserZkCommand}"/>
                    <Button Content="Excel" Command="{Binding ExportExcelJourCommand}" Background="#475569"/>
                    <Button Content="PDF" Command="{Binding ExportPdfJourCommand}" Background="#475569"/>
                </DockPanel>
                <UniformGrid DockPanel.Dock="Top" Columns="3" Margin="0,0,0,12">
                    <TextBlock Text="{Binding CompteurPresents, StringFormat=Présents : {0}}" FontWeight="SemiBold" Foreground="#16A34A"/>
                    <TextBlock Text="{Binding CompteurEnCours, StringFormat=En cours : {0}}" FontWeight="SemiBold" Foreground="#D97706"/>
                    <TextBlock Text="{Binding CompteurAbsents, StringFormat=Absents : {0}}" FontWeight="SemiBold" Foreground="#DC2626"/>
                </UniformGrid>
                <DataGrid ItemsSource="{Binding PresenceJour}" SelectedItem="{Binding LigneJourSelectionnee}">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Matricule" Binding="{Binding Matricule}" Width="100"/>
                        <DataGridTextColumn Header="Employé" Binding="{Binding NomComplet}" Width="*"/>
                        <DataGridTextColumn Header="Entrée" Binding="{Binding PremiereEntree, StringFormat=HH:mm}" Width="80"/>
                        <DataGridTextColumn Header="Sortie" Binding="{Binding DerniereSortie, StringFormat=HH:mm}" Width="80"/>
                        <DataGridTextColumn Header="Heures" Binding="{Binding Heures, StringFormat=0.##}" Width="70"/>
                        <DataGridTextColumn Header="Statut" Binding="{Binding Statut}" Width="90"/>
                        <DataGridTextColumn Header="Poinçons" Binding="{Binding NbPointages}" Width="80"/>
                    </DataGrid.Columns>
                </DataGrid>
            </DockPanel>

            <!-- Rapports -->
            <DockPanel Visibility="{Binding EstRapports, Converter={StaticResource BoolToVis}}">
                <DockPanel DockPanel.Dock="Top" Margin="0,0,0,12">
                    <TextBlock Text="Rapport mensuel" FontSize="24" FontWeight="Bold" VerticalAlignment="Center" Margin="0,0,16,0"/>
                    <TextBlock Text="Mois" VerticalAlignment="Center" Margin="0,0,6,0"/>
                    <TextBox Width="50" Text="{Binding MoisRapport, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,12,0"/>
                    <TextBlock Text="Année" VerticalAlignment="Center" Margin="0,0,6,0"/>
                    <TextBox Width="70" Text="{Binding AnneeRapport, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,12,0"/>
                    <Button Content="Charger" Command="{Binding ChargerRapportCommand}"/>
                    <Button Content="Excel" Command="{Binding ExportExcelMoisCommand}" Background="#475569"/>
                    <Button Content="PDF" Command="{Binding ExportPdfMoisCommand}" Background="#475569"/>
                </DockPanel>
                <DataGrid ItemsSource="{Binding ResumeMois}">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Matricule" Binding="{Binding Matricule}" Width="100"/>
                        <DataGridTextColumn Header="Employé" Binding="{Binding NomComplet}" Width="*"/>
                        <DataGridTextColumn Header="Jours présents" Binding="{Binding JoursPresents}" Width="110"/>
                        <DataGridTextColumn Header="Heures" Binding="{Binding HeuresTotales, StringFormat=0.##}" Width="90"/>
                        <DataGridTextColumn Header="Absences" Binding="{Binding Absences}" Width="90"/>
                    </DataGrid.Columns>
                </DataGrid>
            </DockPanel>

            <!-- Paramètres -->
            <ScrollViewer Visibility="{Binding EstParametres, Converter={StaticResource BoolToVis}}">
                <StackPanel MaxWidth="520" HorizontalAlignment="Left">
                    <TextBlock Text="Paramètres" FontSize="24" FontWeight="Bold" Margin="0,0,0,16"/>
                    <TextBlock Text="Nom de l'entreprise"/>
                    <TextBox Text="{Binding NomEntreprise, UpdateSourceTrigger=PropertyChanged}"/>
                    <TextBlock Text="Pointeuse ZKTeco" FontSize="16" FontWeight="SemiBold" Margin="0,16,0,8"/>
                    <TextBlock Text="Adresse IP"/>
                    <TextBox Text="{Binding ZkIp, UpdateSourceTrigger=PropertyChanged}"/>
                    <TextBlock Text="Port (souvent 4370)"/>
                    <TextBox Text="{Binding ZkPort, UpdateSourceTrigger=PropertyChanged}"/>
                    <TextBlock Text="N° machine"/>
                    <TextBox Text="{Binding ZkMachine, UpdateSourceTrigger=PropertyChanged}"/>
                    <TextBlock Text="Mot de passe communication PC"/>
                    <TextBox Text="{Binding ZkCommPwd, UpdateSourceTrigger=PropertyChanged}"/>
                    <CheckBox Content="Synchronisation automatique" IsChecked="{Binding ZkSyncActif}" Margin="0,8"/>
                    <TextBlock Text="Intervalle (secondes)"/>
                    <TextBox Text="{Binding ZkIntervalle, UpdateSourceTrigger=PropertyChanged}"/>
                    <TextBlock Text="{Binding ZkDerniereSync, StringFormat=Dernière sync : {0}}" Margin="0,8,0,0" Foreground="#64748B"/>
                    <StackPanel Orientation="Horizontal" Margin="0,16,0,0">
                        <Button Content="Enregistrer" Command="{Binding SauverParametresCommand}"/>
                        <Button Content="Tester sync maintenant" Command="{Binding SynchroniserZkCommand}"/>
                    </StackPanel>
                </StackPanel>
            </ScrollViewer>
        </Grid>
    </DockPanel>
</Window>
