<Window x:Class="MelodyPresence.LoginWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:MelodyPresence.ViewModels"
        Title="LT Présence — Connexion"
        Icon="pack://application:,,,/Assets/lt_services.ico"
        Height="620" Width="460"
        MinHeight="560" MinWidth="420"
        WindowStartupLocation="CenterScreen"
        ResizeMode="CanMinimize"
        Background="#FFB8BEC8"
        FontFamily="Segoe UI">

    <Window.DataContext>
        <vm:LoginViewModel/>
    </Window.DataContext>

    <Grid Margin="28">
        <Border Background="White" CornerRadius="16" Padding="28,26"
                BorderBrush="#FF9AA3B0" BorderThickness="1">
            <DockPanel>
                <StackPanel DockPanel.Dock="Top" HorizontalAlignment="Center" Margin="0,0,0,22">
                    <Image Source="pack://application:,,,/Assets/lt_services_brand.jpg"
                           Height="64" Stretch="Uniform"
                           RenderOptions.BitmapScalingMode="HighQuality"/>
                    <TextBlock Text="{Binding TitreEcran}" FontSize="22" FontWeight="Bold"
                               Foreground="#FF0B1220" HorizontalAlignment="Center" Margin="0,16,0,4"/>
                    <TextBlock Text="{Binding SousTitreEcran}" FontSize="12" FontWeight="Bold"
                               Foreground="#FF0B1220" HorizontalAlignment="Center" TextAlignment="Center"
                               TextWrapping="Wrap" Opacity="0.75"/>
                </StackPanel>

                <StackPanel DockPanel.Dock="Bottom" Margin="0,18,0,0">
                    <Button x:Name="BtnPrincipal" Content="{Binding TexteBoutonPrincipal}"
                            Click="BtnPrincipal_Click" Margin="0,0,0,10"
                            MinHeight="42" FontWeight="Bold"/>
                    <Button Content="{Binding TexteLienBasculer}"
                            Command="{Binding BasculerModeCommand}"
                            Style="{StaticResource GhostButton}" Margin="0"
                            HorizontalAlignment="Center" Padding="12,8"/>
                </StackPanel>

                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <StackPanel>
                        <TextBlock Text="Identifiant" Style="{StaticResource FieldLabel}"/>
                        <TextBox Text="{Binding Identifiant, UpdateSourceTrigger=PropertyChanged}"
                                 Margin="0,0,0,12" MinHeight="36"/>

                        <StackPanel Visibility="{Binding ModeCreation, Converter={StaticResource BoolToVis}}">
                            <TextBlock Text="Nom complet" Style="{StaticResource FieldLabel}"/>
                            <TextBox Text="{Binding NomComplet, UpdateSourceTrigger=PropertyChanged}"
                                     Margin="0,0,0,12" MinHeight="36"/>
                        </StackPanel>

                        <TextBlock Text="Mot de passe" Style="{StaticResource FieldLabel}"/>
                        <PasswordBox x:Name="Pwd" Margin="0,0,0,12" MinHeight="36" Padding="10,8"
                                     FontSize="14"/>

                        <StackPanel Visibility="{Binding ModeCreation, Converter={StaticResource BoolToVis}}">
                            <TextBlock Text="Confirmer le mot de passe" Style="{StaticResource FieldLabel}"/>
                            <PasswordBox x:Name="PwdConfirm" Margin="0,0,0,12" MinHeight="36" Padding="10,8"
                                         FontSize="14"/>
                        </StackPanel>

                        <Border Background="#FFF1F2" CornerRadius="10" Padding="12,10"
                                BorderBrush="#66E30613" BorderThickness="1"
                                Visibility="{Binding Message, Converter={StaticResource NullToVis}}">
                            <TextBlock Text="{Binding Message}" FontWeight="Bold" TextWrapping="Wrap" FontSize="12">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Foreground" Value="#FF0B1220"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding MessageErreur}" Value="True">
                                                <Setter Property="Foreground" Value="#FFE30613"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </DockPanel>
        </Border>
    </Grid>
</Window>
